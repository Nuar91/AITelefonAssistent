@page
@model IndexModel
@{
    ViewData["Title"] = "AI Telefonassistent";
}

<div class="text-center">
    <h1 class="display-4">AI Telefonassistent</h1>
    <p>@Model.Begruessung</p>
    <button id="startButton" type="button">Mikrofon starten</button>
    <p id="status">Status: Nicht verbunden</p>
    <p id="recognizedText"></p>
    <p id="assistantResponse"></p>
</div>
<script src="~/js/aiAssistant.js"></script>